{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Application (Vite + Electron)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "env": {
        "VSCODE_DEBUG": "1"
      },
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ]
    }
  ]
}
