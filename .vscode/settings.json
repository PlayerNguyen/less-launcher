{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.d.ts, ${capture}.test.ts, ${capture}.spec.ts, ${capture}.js, ${capture}.js.map",
    "*.tsx": "${capture}.test.tsx, ${capture}.spec.tsx, ${capture}.css, ${capture}.scss"
  }
}